<mujoco model="turtlebot3_waffle_pi_track_a">
  <!-- Official ROBOTIS TurtleBot3 Waffle Pi model (robotis_mujoco_menagerie, Apache-2.0, see
       LICENSE_ROBOTIS.txt; unmodified copy in turtlebot3_waffle_pi_official.xml).
       Track A additions, all marked "TRACK A" below:
         * front_camera at the Raspberry Pi camera mount (Pi Camera v2: 62.2 x 48.8 deg FOV)
         * 72 LiDAR rangefinder rays at the LDS-01 turret, 5 deg apart, 0 = forward, + = left
         * wheel encoder (jointpos) and speed (jointvel) sensors
         * chassis collision mesh replaced by a raised box (reason at the geom below)
         * casters given contact priority so they stay frictionless on the floor (reason at the casters)
         * wheel velocity-servo gain kv 0.1 -> 1.0 (reason at the actuator default below)
       Effect of each change: python part_A_modelling/official_model_checks.py
       The <option> line moved to scene.xml so the scene owns all solver settings. -->
  <compiler angle="radian" meshdir="assets/"/>

  <asset>
    <material name="grey" rgba="0.3 0.3 0.3 1"/>
    <material name="black" rgba="0.1 0.1 0.1 1"/>

    <mesh name="waffle_pi_base" file="waffle_pi_base.stl" scale="0.001 0.001 0.001"/>
    <mesh name="left_tire" file="left_tire.stl" scale="0.001 0.001 0.001"/>
    <mesh name="right_tire" file="right_tire.stl" scale="0.001 0.001 0.001"/>
    <mesh name="lds" file="lds.stl" scale="0.001 0.001 0.001"/>
  </asset>

  <default>
    <!-- Wheel motor -->
    <default class="wheel">
      <joint limited="false" frictionloss="0.1" armature="0.01"/>
      <!-- TRACK A: kv raised from the official 0.1 to 1.0. Against the official 0.1 N m joint frictionloss,
           kv=0.1 leaves the wheels at ~75 % of the commanded speed; the real XL430 runs its own velocity
           loop and tracks closely. kv=1.0 gives ~97 %. -->
      <velocity kv="1.0" ctrlrange="-7.88 7.88" ctrllimited="true"/>
      <default class="wheel_left">
        <joint axis="0 0 1"/>
      </default>
      <default class="wheel_right">
        <joint axis="0 0 1"/>
      </default>
    </default>
    <!-- Visual / Collision -->
    <default class="visual">
      <geom type="mesh" contype="0" conaffinity="0" density="0" group="2"/>
    </default>
    <default class="collision">
      <geom group="3" type="mesh"/>
    </default>
  </default>

  <worldbody>
    <body name="base" pos="0 0 0">
      <inertial pos="-0.064 0 0.06" mass="1.8" diaginertia="0.01 0.01 0.008"/>
      <joint type="free" name="base_joint"/>
      <geom pos="-0.064 0 0.01" mesh="waffle_pi_base" material="black" class="visual"/>
      <!-- TRACK A: the official collision mesh (convex hull of the chassis) reaches the floor and carries
           ~35 % of the robot's weight. Together with the caster issue below this gave ~11 % wheel slip
           driving straight and ~24 % turning on the spot.
           Replaced by a box over the same footprint (x -0.197..0.077, y +-0.139) raised 1 cm off the
           floor, so the wheels and casters carry the load as on the real robot.
      <geom pos="-0.064 0 0.01" mesh="waffle_pi_base" class="collision"/> -->
      <geom name="chassis_collision" type="box" pos="-0.06 0 0.0655" size="0.137 0.139 0.0535" group="3" density="0"/>
      <!-- TRACK A: priority="1" on both casters. Without it MuJoCo mixes contact parameters with the floor
           (max condim, max friction), so the "frictionless" casters get the floor's friction and drag
           sideways in every turn once they carry load. -->
      <geom size="0.005" pos="-0.177 -0.064 0.005" type="sphere" material="grey" friction="0.0001 0.0001 0.0001" solref="0.02 1" solimp="0.95 0.99 0.001" condim="1" priority="1"/>
      <geom size="0.005" pos="-0.177 0.064 0.005" type="sphere" material="grey" friction="0.0001 0.0001 0.0001" solref="0.02 1" solimp="0.95 0.99 0.001" condim="1" priority="1"/>
      <geom pos="-0.049 0 0.1255" mesh="lds" material="black" class="visual"/>
      <geom pos="-0.049 0 0.1255" mesh="lds" class="collision"/>
      <geom size="0.0075 0.015 0.0135" pos="0.078 0 0.107" type="box" material="grey"/>
      <!-- TRACK A: camera on the front face of the Pi camera mount (box above at x=0.078, half-depth 0.0075).
           MuJoCo cameras look along their -Z axis; xyaxes makes image-right = -Y and image-up = +Z. -->
      <camera name="front_camera" pos="0.0856 0 0.107" xyaxes="0 -1 0 0 0 1" fovy="48.8"/>
      <!-- TRACK A: LDS-01 scan plane inside the turret (turret spans x -0.082..0.012, z 0.095..0.135) -->
