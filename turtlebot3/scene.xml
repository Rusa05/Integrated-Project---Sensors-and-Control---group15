<mujoco model="Track A room with TurtleBot3 Waffle Pi">
  <!-- World for Track A: 4 m x 4 m room, two obstacles, ArUco charging station.
       The robot is the official ROBOTIS Waffle Pi model plus Track A sensors
       (turtlebot3_waffle_pi_track_a.xml). Frames: +X east, +Y north, +Z up. SI units. -->
  <compiler angle="radian" autolimits="true"/>
  <!-- timestep/integrator are ours; cone/impratio come from the official Waffle Pi model -->
  <option timestep="0.002" integrator="implicitfast" cone="elliptic" impratio="10"/>
  <visual><global offwidth="960" offheight="720"/><headlight ambient="0.4 0.4 0.4" diffuse="0.7 0.7 0.7"/></visual>

  <include file="turtlebot3_waffle_pi_track_a.xml"/>

  <default>
    <default class="scene_visual"><geom contype="0" conaffinity="0" mass="0"/></default>
  </default>
  <asset>
    <texture name="floor_texture" type="2d" builtin="checker" width="512" height="512" rgb1="0.28 0.32 0.36" rgb2="0.35 0.39 0.43"/>
    <material name="floor_material" texture="floor_texture" texrepeat="8 8" reflectance="0.05"/>
    <!-- ArUco DICT_4X4_50 id 0, generated by part_B_sensing/make_aruco.py -->
    <texture name="aruco_texture" type="2d" file="assets/aruco_dock.png"/>
    <material name="aruco_material" texture="aruco_texture" texrepeat="1 1" texuniform="false"/>
  </asset>
  <worldbody>
    <light pos="0 0 3" dir="0 0 -1" diffuse="0.8 0.8 0.8"/>
    <geom name="floor" type="plane" size="3 3 0.1" material="floor_material"/>
    <geom name="east_wall" type="box" pos="2 0 0.25" size="0.04 2 0.25" rgba="0.7 0.75 0.8 1"/>
    <geom name="west_wall" type="box" pos="-2 0 0.25" size="0.04 2 0.25" rgba="0.7 0.75 0.8 1"/>
    <geom name="north_wall" type="box" pos="0 2 0.25" size="2 0.04 0.25" rgba="0.7 0.75 0.8 1"/>
    <geom name="south_wall" type="box" pos="0 -2 0.25" size="2 0.04 0.25" rgba="0.7 0.75 0.8 1"/>
    <geom name="obstacle_box" type="box" pos="0.9 0.65 0.18" size="0.17 0.2 0.18" rgba="0.95 0.55 0.15 1"/>
    <geom name="obstacle_cylinder" type="cylinder" pos="-0.6 -0.8 0.2" size="0.18 0.2" rgba="0.15 0.65 0.55 1"/>
    <!-- Charging station against the east wall, facing -X (into the room).
         Marker centre is at world (1.9085, -1.0, 0.15); its normal points along -X.
         Black square 0.10 m, plus 0.02 m white border each side.
         dock_goal = wheel-axle centre when docked: robot front (camera, x=+0.086) stops 4 cm from the plate. -->
    <body name="charging_station" pos="1.93 -1.0 0">
      <geom name="dock_backplate" type="box" pos="0 0 0.13" size="0.02 0.2 0.13" rgba="0.25 0.27 0.3 1"/>
      <geom name="dock_pad" class="scene_visual" type="box" pos="-0.21 0 0.002" size="0.17 0.18 0.002" rgba="0.95 0.8 0.1 1"/>
      <geom name="aruco_marker" class="scene_visual" type="plane" pos="-0.0215 0 0.15" size="0.07 0.07 0.01"
            xyaxes="0 -1 0 0 0 1" material="aruco_material"/>
      <site name="marker_centre" pos="-0.0215 0 0.15" xyaxes="0 -1 0 0 0 1" size="0.005" rgba="1 0 0 0"/>
      <site name="dock_goal" pos="-0.15 0 0" size="0.01" rgba="0 1 0 0"/>
    </body>
  </worldbody>
</mujoco>
