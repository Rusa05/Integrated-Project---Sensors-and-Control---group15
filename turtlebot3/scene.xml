<mujoco model="Track A room with TurtleBot3 Waffle Pi">
  <!-- World for Track A: 4 m x 4 m room, two obstacles, ArUco charging station, six wall tags.
       The robot is the official ROBOTIS Waffle Pi model plus Track A sensors
       (turtlebot3_waffle_pi_track_a.xml). Frames: +X east, +Y north, +Z up. SI units. -->
  <compiler angle="radian" autolimits="true"/>
  <!-- timestep/integrator are ours; cone/impratio come from the official Waffle Pi model -->
  <option timestep="0.002" integrator="implicitfast" cone="elliptic" impratio="10"/>
  <visual><global offwidth="960" offheight="720"/><headlight ambient="0.4 0.4 0.4" diffuse="0.7 0.7 0.7"/></visual>

  <include file="turtlebot3_waffle_pi_track_a.xml"/>

  <default>
    <default class="scene_visual"><geom contype="0" conaffinity="0" mass="0"/></default>
  </default>
  <asset>
    <texture name="floor_texture" type="2d" builtin="checker" width="512" height="512" rgb1="0.28 0.32 0.36" rgb2="0.35 0.39 0.43"/>
    <material name="floor_material" texture="floor_texture" texrepeat="8 8" reflectance="0.05"/>
    <!-- ArUco DICT_4X4_50 tags, textures generated by part_B_sensing/make_aruco.py from src/config.py TAGS -->
    <texture name="aruco_0" type="2d" file="assets/aruco_0.png"/>
    <material name="aruco_0" texture="aruco_0" texrepeat="1 1" texuniform="false"/>
    <texture name="aruco_1" type="2d" file="assets/aruco_1.png"/>
    <material name="aruco_1" texture="aruco_1" texrepeat="1 1" texuniform="false"/>
    <texture name="aruco_2" type="2d" file="assets/aruco_2.png"/>
    <material name="aruco_2" texture="aruco_2" texrepeat="1 1" texuniform="false"/>
    <texture name="aruco_3" type="2d" file="assets/aruco_3.png"/>
    <material name="aruco_3" texture="aruco_3" texrepeat="1 1" texuniform="false"/>
    <texture name="aruco_4" type="2d" file="assets/aruco_4.png"/>
    <material name="aruco_4" texture="aruco_4" texrepeat="1 1" texuniform="false"/>
    <texture name="aruco_5" type="2d" file="assets/aruco_5.png"/>
    <material name="aruco_5" texture="aruco_5" texrepeat="1 1" texuniform="false"/>
    <texture name="aruco_6" type="2d" file="assets/aruco_6.png"/>
    <material name="aruco_6" texture="aruco_6" texrepeat="1 1" texuniform="false"/>
    <texture name="aruco_7" type="2d" file="assets/aruco_7.png"/>
    <material name="aruco_7" texture="aruco_7" texrepeat="1 1" texuniform="false"/>
    <texture name="aruco_8" type="2d" file="assets/aruco_8.png"/>
    <material name="aruco_8" texture="aruco_8" texrepeat="1 1" texuniform="false"/>
  </asset>
  <worldbody>
    <light pos="0 0 3" dir="0 0 -1" diffuse="0.8 0.8 0.8"/>
    <geom name="floor" type="plane" size="3 3 0.1" material="floor_material"/>
    <geom name="east_wall" type="box" pos="2 0 0.25" size="0.04 2 0.25" rgba="0.7 0.75 0.8 1"/>
    <geom name="west_wall" type="box" pos="-2 0 0.25" size="0.04 2 0.25" rgba="0.7 0.75 0.8 1"/>
    <geom name="north_wall" type="box" pos="0 2 0.25" size="2 0.04 0.25" rgba="0.7 0.75 0.8 1"/>
    <geom name="south_wall" type="box" pos="0 -2 0.25" size="2 0.04 0.25" rgba="0.7 0.75 0.8 1"/>
    <geom name="obstacle_box" type="box" pos="0.9 0.65 0.18" size="0.17 0.2 0.18" rgba="0.95 0.55 0.15 1"/>
    <geom name="obstacle_cylinder" type="cylinder" pos="-0.6 -0.8 0.2" size="0.18 0.2" rgba="0.15 0.65 0.55 1"/>
    <!-- Charging station against the east wall, facing -X (into the room). Tags (src/config.py):
         id 0, 10 cm, centre z = 0.25 m (seen on the approach); ids 7 and 8, 3 cm, at camera height,
         10 cm apart (stay in view down to the docked pose). dock_goal = wheel-axle centre when docked:
         the camera stops 0.20 m from the backplate. -->
    <body name="charging_station" pos="1.93 -1.0 0">
      <geom name="dock_backplate" type="box" pos="0 0 0.18" size="0.02 0.2 0.18" rgba="0.25 0.27 0.3 1"/>
      <geom name="dock_pad" class="scene_visual" type="box" pos="-0.37 0 0.002" size="0.17 0.18 0.002" rgba="0.95 0.8 0.1 1"/>
      <geom name="aruco_0" class="scene_visual" type="plane" pos="-0.0215 0.0000 0.250" size="0.0700 0.0700 0.01" xyaxes="0 -1 0 0 0 1" material="aruco_0"/>
      <site name="tag_0" pos="-0.0215 0.0000 0.250" xyaxes="0 -1 0 0 0 1" size="0.005" rgba="1 0 0 0"/>
      <geom name="aruco_7" class="scene_visual" type="plane" pos="-0.0215 0.0500 0.107" size="0.0210 0.0210 0.01" xyaxes="0 -1 0 0 0 1" material="aruco_7"/>
      <site name="tag_7" pos="-0.0215 0.0500 0.107" xyaxes="0 -1 0 0 0 1" size="0.005" rgba="1 0 0 0"/>
      <geom name="aruco_8" class="scene_visual" type="plane" pos="-0.0215 -0.0500 0.107" size="0.0210 0.0210 0.01" xyaxes="0 -1 0 0 0 1" material="aruco_8"/>
      <site name="tag_8" pos="-0.0215 -0.0500 0.107" xyaxes="0 -1 0 0 0 1" size="0.005" rgba="1 0 0 0"/>
      <site name="marker_centre" pos="-0.0215 0 0.25" xyaxes="0 -1 0 0 0 1" size="0.005" rgba="1 0 0 0"/>
      <site name="dock_goal" pos="-0.31 0 0" size="0.01" rgba="0 1 0 0"/>
    </body>
    <!-- 15 cm wall tags for localisation (src/config.py TAGS 1-6) -->
    <geom name="aruco_1" class="scene_visual" type="plane" pos="-0.9000 1.9585 0.200" size="0.1050 0.1050 0.01" xyaxes="1 0 0 0 0 1" material="aruco_1"/>
    <site name="tag_1" pos="-0.9000 1.9585 0.200" xyaxes="1 0 0 0 0 1" size="0.005" rgba="1 0 0 0"/>
    <geom name="aruco_2" class="scene_visual" type="plane" pos="0.9000 1.9585 0.200" size="0.1050 0.1050 0.01" xyaxes="1 0 0 0 0 1" material="aruco_2"/>
    <site name="tag_2" pos="0.9000 1.9585 0.200" xyaxes="1 0 0 0 0 1" size="0.005" rgba="1 0 0 0"/>
    <geom name="aruco_3" class="scene_visual" type="plane" pos="-0.9000 -1.9585 0.200" size="0.1050 0.1050 0.01" xyaxes="-1 0 0 0 0 1" material="aruco_3"/>
    <site name="tag_3" pos="-0.9000 -1.9585 0.200" xyaxes="-1 0 0 0 0 1" size="0.005" rgba="1 0 0 0"/>
    <geom name="aruco_4" class="scene_visual" type="plane" pos="0.6000 -1.9585 0.200" size="0.1050 0.1050 0.01" xyaxes="-1 0 0 0 0 1" material="aruco_4"/>
    <site name="tag_4" pos="0.6000 -1.9585 0.200" xyaxes="-1 0 0 0 0 1" size="0.005" rgba="1 0 0 0"/>
    <geom name="aruco_5" class="scene_visual" type="plane" pos="-1.9585 0.0000 0.200" size="0.1050 0.1050 0.01" xyaxes="0 1 0 0 0 1" material="aruco_5"/>
    <site name="tag_5" pos="-1.9585 0.0000 0.200" xyaxes="0 1 0 0 0 1" size="0.005" rgba="1 0 0 0"/>
    <geom name="aruco_6" class="scene_visual" type="plane" pos="1.9585 0.9000 0.200" size="0.1050 0.1050 0.01" xyaxes="0 -1 0 0 0 1" material="aruco_6"/>
    <site name="tag_6" pos="1.9585 0.9000 0.200" xyaxes="0 -1 0 0 0 1" size="0.005" rgba="1 0 0 0"/>
  </worldbody>
</mujoco>
